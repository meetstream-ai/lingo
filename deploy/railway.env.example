# Copy values into Railway Variables, never commit real secrets.
NODE_ENV=production
HOST=0.0.0.0
DATABASE_PATH=/app/data/meetings.sqlite
NGROK_ENABLED=false
# Use the generated Railway HTTPS domain. No trailing slash.
PUBLIC_ORIGIN=https://YOUR-SERVICE.up.railway.app
# Production requires 12+ characters and 32+ characters respectively.
APP_PASSWORD=
SESSION_SECRET=
MEETSTREAM_API_KEY=
GOOGLE_TRANSLATE_API_KEY=
# Attach a persistent volume at /app/data; run ONE replica.
# Ensure the mounted directory is writable by UID 1000 (the image's node user).
# Set /healthz as the service health-check path; disable serverless sleeping.
# After deployment: npm run check:hosting in the service shell.
# Provider connections can also be entered in the hosted browser Connections page.
