# Node 24+. Copy to .env; keep secrets out of source control.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
DATABASE_PATH=data/meetings.sqlite
# Production: set NODE_ENV=production, HOST=0.0.0.0, and serve through an HTTPS reverse proxy.
APP_PASSWORD=
SESSION_SECRET=
PUBLIC_ORIGIN=
# Optional HTTPS: paste your token here. npm start runs the tunnel and app together.
# No ngrok CLI installation is required. Token stays on the server.
NGROK_AUTHTOKEN=
# auto enables tunneling when a token exists. false keeps startup local.
NGROK_ENABLED=auto
# Optional reserved ngrok hostname (without https://). Leave blank for the account default.
NGROK_DOMAIN=
# Per-bot callbacks are automatic. Optional: register PUBLIC_ORIGIN/webhooks/meetstream
# in workspace Webhooks and set its signing secret below.
# Deepgram keys live in MeetStream Integrations; no separate DEEPGRAM_API_KEY is needed.
# MeetStream/translation/sharing credentials can also be saved privately in browser Connections.
MEETSTREAM_API_KEY=
MEETSTREAM_WEBHOOK_SECRET=
# Configure at least one text translation provider. Restrict keys to the appropriate API.
GOOGLE_TRANSLATE_API_KEY=
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=
# Optional sharing; the app never shares automatically.
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=
# OAuth refresh token with https://www.googleapis.com/auth/drive.file access.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
GOOGLE_DRIVE_FOLDER_ID=

# JigsawStack text translation; speech keys for AssemblyAI/JigsawStack are saved in MeetStream Integrations.
JIGSAWSTACK_API_KEY=
# Optional Gmail drafts. OAuth refresh token needs gmail.compose; this app never sends mail.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# Optional separate key for Google Cloud speech. Falls back to GOOGLE_TRANSLATE_API_KEY.
# Enable the Text-to-Speech API and billing in its Google Cloud project.
GOOGLE_TTS_API_KEY=

# Optional automatic meeting names. Enable Calendar API; use a separate read-only OAuth refresh token.
# Scope: https://www.googleapis.com/auth/calendar.events.readonly
CALENDAR_CLIENT_ID=
CALENDAR_CLIENT_SECRET=
CALENDAR_REFRESH_TOKEN=
CALENDAR_ID=primary
# Optional Discord transcript sharing. Keep the webhook URL private.
DISCORD_WEBHOOK_URL=

# Optional DeepL text translator. :fx keys use API Free; other keys use API Pro.
# This adapter exposes a conservative verified catalog; use Google/Azure/JigsawStack for Hindi/Tamil targets.
DEEPL_API_KEY=
